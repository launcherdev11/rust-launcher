# Copy to deploy/.env and adjust for production.
# Never commit real production secrets.
#
# Generate strong secrets, e.g.:
#   openssl rand -base64 48

# development | production
# production requires RESEND_API_KEY and IDENTITY_REQUIRE_PROOF=true
APP_ENV=production

# Postgres (default "launcher" is fine for local only).
# Use URL-safe chars (A-Za-z0-9_-). Required for api service.
POSTGRES_PASSWORD=launcher
DATABASE_URL=postgres://launcher:launcher@postgres:5432/launcher

# Required. At least 32 characters. Must NOT be a known placeholder.
# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=mc16launcher-api
JWT_AUDIENCE=mc16launcher

# Exact browser/Tauri origins allowed by CORS (comma-separated).
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,https://tauri.localhost

# Require live Ely/Minecraft access tokens when linking identities.
IDENTITY_REQUIRE_PROOF=true

# Only true when API sits behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Coturn REST auth — required when TURN_HOST is set (min 16 chars, no placeholders).
# Must match the secret passed to the coturn container (--static-auth-secret).
TURN_HOST=
TURN_SECRET=
TURN_REALM=16launcher.local
TURN_TTL_SECS=600
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Resend (https://resend.com) — required when APP_ENV=production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=16Launcher <noreply@16-launcher.ru>
EMAIL_VERIFICATION_TTL_SECS=600
